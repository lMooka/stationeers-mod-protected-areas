<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ProtectedAreas</AssemblyName>
    <RootNamespace>ProtectedAreas</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Version>1.0.0</Version>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Pasta de instalacao do Stationeers. Pode ser sobrescrita: dotnet build -p:GameDir="D:\...\Stationeers" -->
    <GameDir Condition="'$(GameDir)' == ''">G:\SteamLibrary\steamapps\common\Stationeers</GameDir>
    <ManagedDir>$(GameDir)\rocketstation_Data\Managed</ManagedDir>
    <BepInExDir>$(GameDir)\BepInEx\core</BepInExDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(ManagedDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UniTask.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="$(BepInExDir)\BepInEx.dll" Private="false" />
    <Reference Include="$(BepInExDir)\0Harmony.dll" Private="false" />
    <Reference Include="System.Xml" />
  </ItemGroup>

</Project>
